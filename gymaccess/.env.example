# Configuración general del proyecto — copiar a .env y completar.
# NUNCA subir .env al repositorio (constitución, Principio V).
# Este archivo NO debe contener secretos reales.

# Base de datos MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_NOMBRE=gymaccess
DB_USUARIO=root
DB_CONTRASENA=

# Autenticación
JWT_SECRET=

# Cuenta administradora inicial (seed)
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Reconocimiento facial (Sprint 2 — research R-16)
FACIAL_UMBRAL_COINCIDENCIA=0.6
