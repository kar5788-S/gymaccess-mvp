# Configuración del backend — copiar este archivo a .env y completar.
# NUNCA subir .env al repositorio (constitución, Principio V).
# Este archivo NO debe contener secretos reales.

# Base de datos MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_NOMBRE=gymaccess
DB_USUARIO=root
DB_CONTRASENA=

# Autenticación y servidor
JWT_SECRET=
PORT=4000

# Cuenta administradora inicial (usada por npm run db:seed-admin)
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Reconocimiento facial (Sprint 2 — research R-16)
# Distancia euclidiana máxima considerada coincidencia válida.
# No es un secreto: su valor es ajustable en las pruebas del punto de acceso.
FACIAL_UMBRAL_COINCIDENCIA=0.6
